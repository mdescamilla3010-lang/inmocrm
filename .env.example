# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.
# Con Supabase local (`supabase start`), `supabase status` imprime la URL y las llaves.

# URL pública de la app (se usa en enlaces de correos y redirecciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Llave secreta (service role). Sólo servidor: webhooks, cron, agente, invitaciones.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Cifrado de tokens de terceros (AES-256-GCM). 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64

# --- Fases siguientes (aún no se usan) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=
# WHATSAPP_APP_SECRET=xxxxxxxx
# WHATSAPP_VERIFY_TOKEN=xxxxxxxx
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# CRON_SECRET=xxxxxxxx
