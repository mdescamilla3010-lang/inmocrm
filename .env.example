# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.
# Con Supabase local (`supabase start`), `supabase status` imprime la URL y las llaves.

# URL pública de la app (se usa en enlaces de correos y redirecciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Llave secreta (service role). Sólo servidor: webhooks, cron, agente, invitaciones.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Cifrado de tokens de terceros (AES-256-GCM). 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64

# --- Meta Lead Ads (webhook /api/webhooks/meta-leads) ---
# App Secret de tu app de Meta: verifica la firma X-Hub-Signature-256.
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Texto libre que también pones en Meta al suscribir el webhook.
META_VERIFY_TOKEN=elige-un-texto-aleatorio
META_GRAPH_VERSION=v23.0

# --- Correo entrante de portales (webhook /api/webhooks/correo-entrante, formato Postmark Inbound) ---
# Dominio que recibe los correos: <slug-de-la-inmobiliaria>@CORREO_ENTRANTE_DOMINIO
CORREO_ENTRANTE_DOMINIO=leads.tudominio.mx
# Contraseña Basic auth en la URL del webhook: https://postmark:<secreto>@tu-app/api/webhooks/correo-entrante
CORREO_ENTRANTE_SECRETO=elige-un-secreto-largo

# --- Agente de IA (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modelo y esfuerzo (low | medium | high | xhigh | max). Por defecto claude-opus-5-5 / medium.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- WhatsApp Business Cloud API (webhook /api/webhooks/whatsapp) ---
# App Secret de la app de Meta que tiene el producto WhatsApp (verifica X-Hub-Signature-256).
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=elige-otro-texto-aleatorio
# Espera antes de contestar, para juntar mensajes seguidos del prospecto (ms).
AGENTE_ESPERA_MS=3000

# --- Fases siguientes (aún no se usan) ---
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# CRON_SECRET=xxxxxxxx
